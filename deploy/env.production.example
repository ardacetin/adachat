# Ada Chat production configuration (docs/deployment.md).
# Copy to .env next to compose.production.yml (Docker) or into the
# application directory (bare metal), fill in every value marked CHANGE,
# and never commit the result.

APP_NAME="Ada Chat"
APP_ENV=production
APP_DEBUG=false
# CHANGE: php artisan key:generate --show. Back it up separately from the
# database: it decrypts the provider API keys.
APP_KEY=
# Rotating APP_KEY: put the old key here until provider keys are re-encrypted.
#APP_PREVIOUS_KEYS=
# CHANGE: the public https address.
APP_URL=https://ai.example.edu

DEFAULT_LOCALE=tr
FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Initial values, editable later in the admin panel.
INSTITUTION_NAME="Example University"
INSTITUTION_SHORT_NAME="Example"
INSTITUTION_DOMAIN=example.edu
INSTITUTION_TIMEZONE=Europe/Istanbul
AUTH_ALLOWED_DOMAINS=example.edu
AUTH_AUTO_PROVISION=true

# CHANGE: from the Google Workspace SAML app (docs/authentication.md).
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_CERT=
#SAML_IDP_CERT_PATH=/etc/ada/google-saml.pem

ADA_DEV_LOGIN=false
ADA_DEFAULT_MONTHLY_LIMIT_USD=10
# Chat attachments (MB); nginx and PHP allow up to 6 MB per file.
ADA_ATTACHMENT_MAX_IMAGE_MB=5
ADA_ATTACHMENT_MAX_TEXT_MB=1

# Reverse proxies whose X-Forwarded-* headers are trusted: addresses or CIDR
# ranges, comma-separated. Leave empty when nginx talks to PHP-FPM directly.
# (The Docker compose file sets * because its port is bound to 127.0.0.1.)
TRUSTED_PROXIES=

# JSON lines in storage/logs/ada-YYYY-MM-DD.log, kept LOG_DAILY_DAYS days.
# (Docker: stderr, set in compose.production.yml.)
LOG_CHANNEL=json
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# Docker only: PHP-FPM workers, i.e. answers that can stream at once plus
# page requests (docs/deployment.md, "Sizing"). Without Docker: the pool file.
#PHP_FPM_MAX_CHILDREN=24

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ada
DB_USERNAME=ada
# CHANGE: a long random password.
DB_PASSWORD=

# Redis for sessions and cache (budget correctness never depends on it).
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_MAX_LIFETIME=10080
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# E-mail for the cap alerts and the monthly report (Admin → Institution →
# Notification e-mails; "Send a test e-mail" checks these settings). With
# MAIL_MAILER=log, messages are only written to the log.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.edu
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ada@example.edu"
MAIL_FROM_NAME="Ada Chat"
