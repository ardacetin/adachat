# Ada Chat environment configuration.
# Never commit a real .env file or real credentials.

APP_NAME="Ada Chat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# UI locales: see config/ada.php. These are initial values only;
# the institution default becomes an admin setting in M3.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
DEFAULT_LOCALE=en
FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

# --- Institution (initial values, seeded into settings by ada:install) ---
INSTITUTION_NAME="Example University"
INSTITUTION_SHORT_NAME="Example"
INSTITUTION_DOMAIN=example.edu
INSTITUTION_TIMEZONE=UTC

# --- Authentication ---
# Comma-separated e-mail domains allowed to sign in.
AUTH_ALLOWED_DOMAINS=example.edu

# SAML 2.0 sign-in (Google Workspace custom SAML app). Copy the values from
# the IdP metadata; in Google Admin enter Ada's ACS URL ${APP_URL}/auth/saml/acs
# and Entity ID ${APP_URL}/auth/saml/metadata (see docs/authentication.md).
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_CERT=
#SAML_IDP_CERT_PATH=/etc/ada/google-saml.pem
#SAML_ATTRIBUTE_FIRST_NAME=first_name
#SAML_ATTRIBUTE_LAST_NAME=last_name

# Create users on their first successful sign-in (false = pre-created users only).
AUTH_AUTO_PROVISION=true

# Password-less development login (only active when APP_ENV is local/testing).
ADA_DEV_LOGIN=false

# --- AI providers (optional fallback; prefer the admin panel) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Monthly USD limit of the Default budget policy created on installation.
ADA_DEFAULT_MONTHLY_LIMIT_USD=10

# Token counting before each request: estimate (conservative) or reject when a
# provider count endpoint fails.
ADA_ON_COUNTER_FAILURE=estimate

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: MySQL 8.4 LTS is the only supported database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ada
DB_USERNAME=ada
DB_PASSWORD=secret

# Development uses database drivers; production should use Redis for
# sessions, cache and queues (budget correctness never depends on Redis).
SESSION_DRIVER=database
SESSION_LIFETIME=480
# Absolute maximum after sign-in, in minutes (default 7 days).
SESSION_MAX_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ada@example.edu"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
